# Document Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# A server-owned key is disabled by default on public deployments. Users enter
# their own key in the password field for the current Streamlit session.

# Required — obtain a free key from https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Set true only for a controlled/private deployment whose users you trust.
ALLOW_SERVER_API_KEY=false

